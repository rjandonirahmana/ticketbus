# Postgres
DATABASE_URL=postgres://rjandoni@localhost:5432/bis
AUTO_MIGRATE=true

# Admin — SATU akun istimewa, di-seed otomatis saat startup (bukan self-register).
# Login pakai ADMIN_PHONE + ADMIN_PASSWORD lewat form /login yang sama dengan
# buyer/merchant.
ADMIN_PHONE=6281234567890
ADMIN_NAME="Admin PO Nyentrix Trans"
ADMIN_PASSWORD=nyentrix123
# HARUS diganti di produksi — string acak panjang dipakai men-tanda-tangani
# SEMUA cookie sesi (buyer/merchant/admin).
SESSION_SECRET=dev-only-change-me

# WAHA (WhatsApp HTTP API) — kirim OTP pendaftaran & password akun baru.
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=

# RustFS (S3-compatible object storage untuk foto trip)
RUSTFS_ENDPOINT=http://172.17.0.1:9000
RUSTFS_BUCKET=nyentrix-trans
RUSTFS_ACCESS_KEY=changeme
RUSTFS_SECRET_KEY=changeme
RUSTFS_PUBLIC_URL=http://172.17.0.1:9000/nyentrix-trans

SITE_ADDR=0.0.0.0:3000

# Peta (CARTO). Keduanya opsional — kosong = CARTO Positron publik.
# CARTO_TILE_URL = template Leaflet; boleh memuat {apikey} (diganti CARTO_API_KEY).
# Bila tak ada {apikey}, kunci ditambahkan otomatis sebagai ?api_key=...
# Kunci ikut terlihat di browser → batasi kunci ke domain lajubus.online.
CARTO_TILE_URL=jsjsjs
CARTO_API_KEY=ahaajaj
